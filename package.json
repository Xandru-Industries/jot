{
  "name": "@mariozechner/jot",
  "version": "0.1.2",
  "bin": {
    "jot": "cli/jot.mjs"
  },
  "files": [
    "dist",
    "public",
    "cli"
  ],
  "description": "Minimal self-hosted markdown editor with inline comment threads",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:server": "tsc",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js",
    "start:test": "node dist/server.js --port=43210 --data=.tmp/playwright-data",
    "test:browser": "playwright test",
    "test:e2e": "playwright test",
    "test": "node tests/run-suite.mjs"
  },
  "dependencies": {
    "@milkdown/core": "7.22.1",
    "@milkdown/plugin-clipboard": "7.22.1",
    "@milkdown/plugin-history": "7.22.1",
    "@milkdown/plugin-listener": "7.22.1",
    "@milkdown/preset-commonmark": "7.22.1",
    "@milkdown/preset-gfm": "7.22.1",
    "@milkdown/utils": "7.22.1",
    "articulated": "^1.3.1",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "marked": "^16.4.1",
    "mermaid": "^11.14.0",
    "remark-frontmatter": "^5.0.0",
    "sanitize-html": "^2.17.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
